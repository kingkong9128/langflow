{
  "$schema": "https://railway.com/railway.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "preferLocal": true
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "uv run uvicorn langflow.main:app --host 0.0.0.0 --port 7860"
  }
}
