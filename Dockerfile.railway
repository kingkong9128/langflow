# syntax=docker/dockerfile:1
# Railway deployment - builds from source to include custom auth code
# Serves both backend API and frontend via nginx + supervisord

################################
# PYTHON BUILDER
################################
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS python-builder

WORKDIR /app

ENV RUSTFLAGS='--cfg reqwest_unstable'

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install --no-install-recommends -y \
        build-essential \
        gcc \
        git \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY ./src/backend ./src/backend
COPY ./src/lfx ./src/lfx
COPY ./src/sdk ./src/sdk

RUN uv venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

RUN uv pip install ./src/sdk ./src/lfx "./src/backend/base[complete,postgresql]"

################################
# FRONTEND BUILDER
################################
FROM node:22-alpine AS frontend-builder

WORKDIR /app

ENV BACKEND_URL=http://localhost:8080

COPY ./src/frontend/package.json ./src/frontend/package-lock.json* ./
RUN npm ci

COPY ./src/frontend/ ./
RUN npm run build

################################
# RUNTIME
################################
FROM python:3.12.13-slim-trixie AS runtime

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install --no-install-recommends -y \
        curl \
        git \
        libpq5 \
        gnupg \
        xz-utils \
        nginx \
        gettext \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=python-builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=python-builder /usr/local/bin/uvx /usr/local/bin/uvx

RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "amd64" ]; then NODE_ARCH="x64"; \
       elif [ "$ARCH" = "arm64" ]; then NODE_ARCH="arm64"; \
       else NODE_ARCH="$ARCH"; fi \
    && NODE_VERSION=$(curl -fsSL https://nodejs.org/dist/latest-v22.x/ \
                    | sed -nE "s/.*node-v([0-9]+\.[0-9]+\.[0-9]+)-linux-${NODE_ARCH}\.tar\.xz.*/\1/p" \
                    | head -1) \
    && if [ -z "$NODE_VERSION" ]; then echo "ERROR: Could not determine Node.js version" && exit 1; fi \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1

RUN useradd --uid=1000 --gid=0 --no-create-home --home-dir=/app/data user

COPY --from=python-builder --chown=1000:0 /app/.venv /app/.venv
COPY ./lfx.toml /app/lfx.toml
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

COPY --from=frontend-builder --chown=1000:0 /app/build /usr/share/nginx/html

COPY docker/frontend/default.conf.template /etc/nginx/conf.d/default.conf.template
COPY docker/frontend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN mkdir -p /app/data /tmp/nginx && chown -R 1000:0 /app/data && chown 1000:0 /app

LABEL org.opencontainers.image.title="langflow-railway"
LABEL org.opencontainers.image.authors=["AccountexAI"]

USER user
WORKDIR /app

ENV LANGFLOW_HOST=0.0.0.0
ENV LANGFLOW_PORT=8080
ENV BACKEND_URL=http://localhost:8080

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
